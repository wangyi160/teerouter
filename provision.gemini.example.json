{
  "config": {
    "server": {
      "bind": "127.0.0.1:4000",
      "admin_key_ref": "admin"
    },
    "keys": [
      {
        "name": "user",
        "key_ref": "client",
        "user_id": "test-user"
      }
    ],
    "models": [
      {
        "name": "gemini",
        "discover": true,
        "strategy": "round_robin",
        "deployments": [
          {
            "id": "gemini-1",
            "provider": "gemini",
            "oauth_account": "gemini-1"
          }
        ],
        "provider": "gemini"
      }
    ],
    "users": [
      {
        "id": "test-user",
        "max_concurrent": 16
      }
    ],
    "compatibility": {
      "gemini": {
        "requests": {
          "oauth_refresh": {
            "body_set": {
              "/client_id": "REPLACE_WITH_MATCHING_GOOGLE_CLIENT_ID"
            },
            "client_secret_ref": "google-oauth-app-secret"
          }
        }
      }
    }
  },
  "secrets": {
    "client": "REPLACE_WITH_ROUTER_KEY",
    "admin": "REPLACE_WITH_SEPARATE_ADMIN_KEY",
    "google-oauth-app-secret": "REPLACE_WITH_MATCHING_GOOGLE_CLIENT_SECRET"
  },
  "accounts": {
    "gemini-1": {
      "provider": "gemini",
      "proxy": "http://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:18081",
      "credential": {
        "access_token": "REPLACE_WITH_ACCESS_TOKEN",
        "refresh_token": "REPLACE_WITH_REFRESH_TOKEN",
        "expiry_date": 1
      }
    }
  }
}
